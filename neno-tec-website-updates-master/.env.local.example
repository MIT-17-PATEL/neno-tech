# ── Server-side only (NO VITE_ prefix = never sent to browser) ──
# These are used by Vercel serverless functions in /api/
# Set these in Vercel Dashboard > Settings > Environment Variables

SHEET_ENDPOINT=https://script.google.com/macros/s/YOUR_CONTACT_SCRIPT_ID/exec
TALENT_SHEET_ENDPOINT=https://script.google.com/macros/s/YOUR_TALENT_SCRIPT_ID/exec
CAREERS_SHEET_ENDPOINT=https://script.google.com/macros/s/YOUR_CAREERS_SCRIPT_ID/exec
