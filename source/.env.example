# ==============================================================================
# Neno Technology - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local in the source/ directory, or add these keys
# into the Vercel Project Dashboard: Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database URL (Required)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/NenoDB

# ------------------------------------------------------------------------------
# 2. SMTP Email Service (Required for sending OTP & password reset emails)
# ------------------------------------------------------------------------------
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465 (or 587)
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password (generated in Google Account -> Security -> App Passwords)
#   SMTP_FROM="Neno Security" <your-email@gmail.com>
#
# For Custom Domain / Hostinger / Zoho / SendGrid / Resend:
#   SMTP_HOST=smtp.your-provider.com
#   SMTP_PORT=587
#   SMTP_USER=info@neno.tech
#   SMTP_PASSWORD=your_email_password
#   SMTP_FROM="Neno Security" <info@neno.tech>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Neno Security" <your-email@gmail.com>

# ------------------------------------------------------------------------------
# 3. Odoo CRM Lead Integration (Required for automatic CRM synchronization)
# ------------------------------------------------------------------------------
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=admin@your-company.com
ODOO_API_KEY=your_odoo_api_key_here

# ------------------------------------------------------------------------------
# 4. Microsoft Excel / Power Automate Webhooks (Optional for lead backup)
# ------------------------------------------------------------------------------
CONTACT_EXCEL_WEBHOOK_URL=https://prod-xx.westus.logic.azure.com:443/workflows/...
MICROSOFT_EXCEL_WEBHOOK_URL=https://prod-xx.westus.logic.azure.com:443/workflows/...
