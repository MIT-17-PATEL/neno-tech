# ==============================================================================
# Neno Technology - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development, or add these keys into the
# Vercel Project Dashboard: Settings -> Environment Variables.
# All variables are optional for local development (safe fallbacks enabled).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Odoo CRM Lead Integration (Required for automatic CRM synchronization)
# ------------------------------------------------------------------------------
# The base URL of your Odoo ERP/CRM instance (without trailing slash)
ODOO_URL=https://your-company.odoo.com

# The database name of your Odoo instance
ODOO_DB=your_database_name

# Odoo user email or username with CRM write permissions
ODOO_USERNAME=admin@your-company.com

# Odoo API Key (recommended: generated under Preferences -> Account Security)
ODOO_API_KEY=your_odoo_api_key_here

# Odoo Password (fallback if ODOO_API_KEY is not provided)
# ODOO_PASSWORD=your_odoo_password_here

# ------------------------------------------------------------------------------
# 2. Microsoft Excel / Power Automate Webhooks (Optional for lead backup)
# ------------------------------------------------------------------------------
# Webhook URL for general consultation & contact inquiries
CONTACT_EXCEL_WEBHOOK_URL=https://prod-xx.westus.logic.azure.com:443/workflows/...

# Webhook URL for career and job application submissions
MICROSOFT_EXCEL_WEBHOOK_URL=https://prod-xx.westus.logic.azure.com:443/workflows/...
